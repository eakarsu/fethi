DATABASE_URL=postgresql://fethi_app:change-me@127.0.0.1:5432/fethi
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=3001
FRONTEND_PORT=3000
PROVIDER_TIMEOUT_MS=15000

# All integrations are fail-closed. Populate only with provider-issued credentials.
OCR_API_URL=
OCR_API_TOKEN=
ESIGN_API_URL=
ESIGN_API_TOKEN=
ESIGN_WEBHOOK_SECRET=
FILING_API_URL=
FILING_API_TOKEN=
STORAGE_API_URL=
STORAGE_API_TOKEN=
TEMPLATE_API_URL=
TEMPLATE_API_TOKEN=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
